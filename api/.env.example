# Variables d'environnement du serveur (Render : page du service > Environment). Jamais dans le dépôt.
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/douira   # Supabase : URL du « Session pooler » (…pooler.supabase.com:5432) ; le TLS est imposé par le code, pas besoin de sslmode
DATABASE_CA=api/supabase/supabase-ca.crt   # certificat racine Supabase (public, versionné dans le dépôt) : authentifie le serveur de base (TLS vérifié). Chemin d'un fichier, ou le PEM lui-même.
DATA_KEY=                     # node api/cli.js keygen  (32 octets base64) : chiffre adresses, codes d'accès, identifiants e-mail, sauvegardes
SITE_URL=https://www.votre-domaine.ma
ADMIN_EMAIL=admin@votre-domaine.ma   # identifiant de l'administrateur principal (créé au premier démarrage) — obligatoire en production
# ADMIN_NAME=                 # nom du titulaire, tel qu'il paraît sur son badge d'équipe et en tête de ses messages (défaut : « Administrateur »)
# ADMIN_INITIAL_PASSWORD=     # OBLIGATOIRE en production (10 car. min.), sinon aucun admin n'est créé ; hors production, défaut admin123 — à changer à la première connexion
NODE_ENV=production

# Paiement : stripe | cmi | simulate (simulate refusé en production)
PSP=stripe
STRIPE_SECRET_KEY=sk_test_...     # clé de TEST tant que tout n'est pas vérifié ; une clé réelle (sk_live_) n'est acceptée qu'avec NODE_ENV=production
STRIPE_WEBHOOK_SECRET=whsec_...   # secret du webhook DU MÊME MODE que la clé (test/réel) → https://www.votre-domaine.ma/api/webhooks/stripe (checkout.session.*, charge.refunded)
# CMI_CLIENT_ID=
# CMI_STORE_KEY=
# CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate

# Connexion Google / Apple (SSO) : identifiants client OAuth acceptés (aud du jeton), séparés par des virgules.
# Vides = boutons SSO inactifs (le serveur refuse tout jeton). L'appli n'affiche le bouton que si son ID client est réglé de son côté aussi.
GOOGLE_OAUTH_AUDIENCES=    # ex. 1234-ios.apps.googleusercontent.com,1234-web.apps.googleusercontent.com (Google Cloud Console > Identifiants)
APPLE_OAUTH_AUDIENCES=     # ex. ma.douira.appli (identifiant de l'app ; ajouter un Services ID pour une connexion web)

# E-mails : rien ici — l'administrateur configure SMTP ou Resend dans le site (Mon espace > E-mails), identifiants chiffrés en base

# Facultatif
SITE_TZ=Africa/Casablanca     # fuseau du site : décide du jour d'arrivée, des annulations et de la remise des codes d'accès
HOLD_MINUTES=30               # dates bloquées pendant le paiement
SESSION_HOURS=336             # sessions clients (14 jours) ; ADMIN_SESSION_HOURS=8
LOG_REQUESTS=0                # 1 = journal d'accès complet
TRUST_PROXY=1                 # NOMBRE de mandataires devant le serveur (Render seul = 1 ; Cloudflare devant Render = 2 ; 0 = aucun). L'adresse du client est lue à cette position depuis la FIN de X-Forwarded-For
ANTHROPIC_API_KEY=            # assistant des voyageurs : absente = assistant désactivé, l'appli n'affiche pas l'entrée
# ASSISTANT_MODEL=claude-opus-5-5   # modèle de l'assistant ; claude-haiku-5-5 coûte bien moins cher si le volume monte
# ASSISTANT_EFFORT=low              # profondeur de réflexion : low convient à du chat, monter si les réponses tombent à côté
# ASSISTANT_DAILY_MAX=3000          # plafond d'échanges par jour pour TOUT le site (en plus de 60/h et 200/j par compte) : borne la facture

# Comparaison faciale : humain (défaut) | rekognition | simulate (jamais en production)
# KYC_PROVIDER=rekognition
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# KYC_MIN_SIMILARITY=99   # seuil d'acceptation automatique ; sous ce seuil, un humain tranche (jamais de refus automatique)
