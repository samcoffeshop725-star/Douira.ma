# Hébergement Apache (offres mutualisées) : en-têtes de sécurité, HTTPS, page 404
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType video/mp4 .mp4 .m4v
AddType video/webm .webm
AddType video/quicktime .mov
ErrorDocument 404 /404.html
Options -Indexes
# Rien de ce qui n'est pas le site ne se sert : code du serveur, migrations SQL,
# documents internes, sauvegardes, dépôt Git. Sur Render, server.js ne sert que
# ce qu'il liste ; ici c'est Apache qui sert le dossier, il faut le lui dire.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^(api|sauvegardes|\.git|build|node_modules)(/|$) - [R=404,L]
  # Adresses courtes (boutiques d'applications) vers les vues du site
  RewriteRule ^(confidentialite|privacy)/?$ /#legal-privacy [NE,R=302,L]
  RewriteRule ^cgu/?$ /#legal-cgu [NE,R=302,L]
  RewriteRule ^(support|aide)/?$ /#legal-mentions [NE,R=302,L]
</IfModule>
<FilesMatch "\.(md|sql|mjs|yaml|yml|env|example|lock|py)$|^(server\.js|package(-lock)?\.json|GATE\.md|DESIGN\.md)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-u8D2bwiB6sDgnXl/w9CLTJGiSF5qoUa315P+rbpBnfg=' 'sha256-GdY8jcU132B4K9c8xy7mmHHZIbslgEX3dCMyzDJfWoE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://api.maptiler.com https://tiles.stadiamaps.com; media-src 'self' blob:; connect-src 'self' https://open.er-api.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "^(index\.html|config\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
